{
  "expo": {
    "name": "My Dream",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/logo.png",
      "bundleIdentifier": "mydream.app"
    },
    "android": {
      "package": "ir.mydreamapp.app",
      "versionCode": 1,
      "icon": "./assets/images/logo.png",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#080A0E"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/faveicon.png",
      "name": "My Dream",
      "shortName": "My Dream",
      "lang": "fa",
      "description": "اپلیکیشن آشنایی و دوستیابی",
      "themeColor": "#FF6F9F",
      "backgroundColor": "#080A0E"
    },
    "plugins": [
      [
        "expo-router",
        {
          "unstable_useServerRendering": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080A0E",
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#080A0E"
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF6F9F"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "برای ارسال پیام صوتی به میکروفون دسترسی لازم است."
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c676c6b8-c71d-4dd1-9257-d56bc4cc4b98"
      }
    },
    "owner": "mehdirashid"
  }
}
