ARG UBUNTU_IMAGE=docker.iranserver.com/ubuntu:24.04
ARG NODE_VERSION=22.13.1
ARG NODE_DOWNLOAD_BASE=https://nodejs.org/dist
ARG GRADLE_VERSION=9.3.1
ARG ANDROID_REPOSITORY_URL=https://redirector.gvt1.com/edgedl/android/repository

FROM ${UBUNTU_IMAGE} AS android-base

ARG NODE_VERSION
ARG NODE_DOWNLOAD_BASE
ARG GRADLE_VERSION
ARG ANDROID_REPOSITORY_URL

ENV ANDROID_HOME=/opt/android-sdk \
  ANDROID_SDK_ROOT=/opt/android-sdk \
  DEBIAN_FRONTEND=noninteractive \
  GOOGLE_MAVEN_REPOSITORY=https://maven.aliyun.com/repository/google \
  MAVEN_CENTRAL_REPOSITORY=https://maven.aliyun.com/repository/public \
  GRADLE_PLUGIN_REPOSITORY=https://maven.aliyun.com/repository/gradle-plugin \
  JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
  NODE_HOME=/opt/node \
  GRADLE_HOME=/opt/gradle \
  CI=1 \
  EXPO_NO_TELEMETRY=1 \
  PATH=/opt/node/bin:/opt/gradle/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:$PATH

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    openjdk-17-jdk-headless \
    unzip \
    xz-utils \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fL --retry 5 --retry-all-errors --retry-delay 5 --connect-timeout 20 --max-time 600 \
    "${NODE_DOWNLOAD_BASE}/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.tar.xz \
  && mkdir -p "$NODE_HOME" \
  && tar -xJf /tmp/node.tar.xz -C "$NODE_HOME" --strip-components=1 \
  && rm /tmp/node.tar.xz \
  && node --version \
  && npm --version

RUN mkdir -p "$ANDROID_HOME/cmdline-tools" \
  && curl -fL --retry 5 --retry-all-errors --retry-delay 5 --connect-timeout 20 --max-time 600 \
    "${ANDROID_REPOSITORY_URL}/commandlinetools-linux-14742923_latest.zip" -o /tmp/cmdline-tools.zip \
  && unzip -q /tmp/cmdline-tools.zip -d "$ANDROID_HOME/cmdline-tools" \
  && mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest" \
  && rm /tmp/cmdline-tools.zip

RUN curl -fL --retry 5 --retry-all-errors --retry-delay 5 --connect-timeout 20 --max-time 600 \
    "${ANDROID_REPOSITORY_URL}/platform-tools_r36.0.0-linux.zip" -o /tmp/platform-tools.zip \
  && unzip -q /tmp/platform-tools.zip -d "$ANDROID_HOME" \
  && rm /tmp/platform-tools.zip

RUN mkdir -p "$ANDROID_HOME/platforms" "$ANDROID_HOME/build-tools" "$ANDROID_HOME/licenses" \
  && curl -fL --retry 5 --retry-all-errors --retry-delay 5 --connect-timeout 20 --max-time 600 \
    "${ANDROID_REPOSITORY_URL}/platform-36_r01.zip" -o /tmp/platform-36.zip \
  && unzip -q /tmp/platform-36.zip -d /tmp/platform-36 \
  && mv /tmp/platform-36/* "$ANDROID_HOME/platforms/android-36" \
  && rm -rf /tmp/platform-36 /tmp/platform-36.zip

RUN curl -fL --retry 5 --retry-all-errors --retry-delay 5 --connect-timeout 20 --max-time 600 \
    "${ANDROID_REPOSITORY_URL}/build-tools_r36_linux.zip" -o /tmp/build-tools-36.zip \
  && unzip -q /tmp/build-tools-36.zip -d /tmp/build-tools-36 \
  && mv /tmp/build-tools-36/* "$ANDROID_HOME/build-tools/36.0.0" \
  && rm -rf /tmp/build-tools-36 /tmp/build-tools-36.zip \
  && printf '%s\n' \
    '8933bad161af4178b1185d1a37fbf41ea5269c55' \
    'd56f5187479451eabf01fb78af6dfcb131a6481e' \
    '24333f8a63b6825ea9c5514f83c2829b004d1fee' \
    > "$ANDROID_HOME/licenses/android-sdk-license" \
  && find "$ANDROID_HOME/platforms/android-36" -maxdepth 1 -type f -name android.jar | grep -q . \
  && find "$ANDROID_HOME/build-tools/36.0.0" -maxdepth 1 -type f -name aapt2 | grep -q . \
  && curl -fL --retry 5 --retry-all-errors --retry-delay 5 --connect-timeout 20 --max-time 600 \
    "https://downloads.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o /tmp/gradle.zip \
  && unzip -q /tmp/gradle.zip -d /opt \
  && mv "/opt/gradle-${GRADLE_VERSION}" "$GRADLE_HOME" \
  && rm /tmp/gradle.zip \
  && gradle --version

WORKDIR /app

FROM android-base AS deps
COPY package*.json ./

ARG NPM_INSTALL_MODE=online
RUN --mount=type=cache,id=mydream-npm,target=/root/.npm,sharing=locked \
  --mount=type=secret,id=npm_user,required=false \
  --mount=type=secret,id=npm_pass,required=false \
  set -eu; \
  npm_flags="--prefer-offline"; \
  if [ "$NPM_INSTALL_MODE" = "offline" ]; then \
    npm_flags="$npm_flags --offline"; \
  fi; \
  if [ -s /run/secrets/npm_user ] && [ -s /run/secrets/npm_pass ]; then \
    npm_user="$(cat /run/secrets/npm_user)"; \
    npm_pass="$(cat /run/secrets/npm_pass)"; \
    pass64="$(printf '%s' "$npm_pass" | base64 | tr -d '\n')"; \
    printf "registry=https://nexus.gosafir.com/repository/npm-group/\n//nexus.gosafir.com/repository/npm-group/:username=%s\n//nexus.gosafir.com/repository/npm-group/:_password=%s\n//nexus.gosafir.com/repository/npm-group/:email=ci@example.com\n" "$npm_user" "$pass64" > /tmp/npmrc; \
    NPM_CONFIG_USERCONFIG=/tmp/npmrc npm ci $npm_flags; \
    rm -f /tmp/npmrc; \
  else \
    npm ci $npm_flags; \
  fi

FROM deps AS android-build
COPY . .

ARG EXPO_PUBLIC_API_URL
ARG EXPO_PUBLIC_KC_URL
ARG EXPO_PUBLIC_KC_SECRET
ARG GRADLE_OFFLINE=false

ENV EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL} \
  EXPO_PUBLIC_KC_URL=${EXPO_PUBLIC_KC_URL} \
  EXPO_PUBLIC_KC_SECRET=${EXPO_PUBLIC_KC_SECRET}

RUN --mount=type=cache,id=mydream-expo,target=/root/.expo,sharing=locked \
  --mount=type=cache,id=mydream-gradle,target=/root/.gradle,sharing=locked \
  set -eu; \
  mkdir -p /root/.gradle; \
  printf '%s\n' \
    "def googleMirror = System.getenv('GOOGLE_MAVEN_REPOSITORY')" \
    "def centralMirror = System.getenv('MAVEN_CENTRAL_REPOSITORY')" \
    "def pluginMirror = System.getenv('GRADLE_PLUGIN_REPOSITORY')" \
    "settingsEvaluated { settings ->" \
    "  settings.pluginManagement.repositories {" \
    "    maven { url = uri(googleMirror) }" \
    "    maven { url = uri(pluginMirror) }" \
    "    google()" \
    "    mavenCentral()" \
    "    gradlePluginPortal()" \
    "  }" \
    "  try {" \
    "    settings.dependencyResolutionManagement.repositories {" \
    "      maven { url = uri(googleMirror) }" \
    "      maven { url = uri(centralMirror) }" \
    "      google()" \
    "      mavenCentral()" \
    "    }" \
    "  } catch (ignored) {}" \
    "}" \
    "gradle.beforeProject { project ->" \
    "  project.buildscript.repositories {" \
    "    maven { url = uri(googleMirror) }" \
    "    maven { url = uri(centralMirror) }" \
    "    google()" \
    "    mavenCentral()" \
    "  }" \
    "  project.repositories {" \
    "    maven { url = uri(googleMirror) }" \
    "    maven { url = uri(centralMirror) }" \
    "    google()" \
    "    mavenCentral()" \
    "  }" \
    "}" \
    "allprojects {" \
    "  repositories {" \
    "    maven { url = uri(googleMirror) }" \
    "    maven { url = uri(centralMirror) }" \
    "    google()" \
    "    mavenCentral()" \
    "  }" \
    "}" \
    > /root/.gradle/init.gradle; \
  gradle_flags="--build-cache --no-daemon"; \
  if [ "$GRADLE_OFFLINE" = "true" ]; then \
    gradle_flags="$gradle_flags --offline"; \
  fi; \
  npx expo prebuild --platform android \
  && cd android \
  && gradle assembleRelease $gradle_flags

FROM scratch AS android-artifacts
COPY --from=android-build /app/android/app/build/outputs/apk/release/ /
