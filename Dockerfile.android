ARG UBUNTU_IMAGE=ubuntu:24.04
ARG NODE_VERSION=22.13.1
ARG NODE_DOWNLOAD_BASE=https://nodejs.org/dist
ARG ANDROID_REPOSITORY_URL=https://dl.google.com/android/repository

FROM ${UBUNTU_IMAGE} AS android-base

ARG NODE_VERSION
ARG NODE_DOWNLOAD_BASE
ARG ANDROID_REPOSITORY_URL

ENV ANDROID_HOME=/opt/android-sdk \
  ANDROID_SDK_ROOT=/opt/android-sdk \
  DEBIAN_FRONTEND=noninteractive \
  JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
  NODE_HOME=/opt/node \
  CI=1 \
  EXPO_NO_TELEMETRY=1 \
  PATH=/opt/node/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:$PATH

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    openjdk-17-jdk-headless \
    unzip \
    xz-utils \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fL --retry 5 --retry-all-errors --retry-delay 5 --connect-timeout 20 --max-time 600 \
    "${NODE_DOWNLOAD_BASE}/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.tar.xz \
  && mkdir -p "$NODE_HOME" \
  && tar -xJf /tmp/node.tar.xz -C "$NODE_HOME" --strip-components=1 \
  && rm /tmp/node.tar.xz \
  && node --version \
  && npm --version

RUN mkdir -p "$ANDROID_HOME/cmdline-tools" \
  && curl -fL --retry 5 --retry-all-errors --retry-delay 5 --connect-timeout 20 --max-time 600 \
    "${ANDROID_REPOSITORY_URL}/commandlinetools-linux-14742923_latest.zip" -o /tmp/cmdline-tools.zip \
  && unzip -q /tmp/cmdline-tools.zip -d "$ANDROID_HOME/cmdline-tools" \
  && mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest" \
  && rm /tmp/cmdline-tools.zip

RUN curl -fL --retry 5 --retry-all-errors --retry-delay 5 --connect-timeout 20 --max-time 600 \
    "${ANDROID_REPOSITORY_URL}/platform-tools_r36.0.0-linux.zip" -o /tmp/platform-tools.zip \
  && unzip -q /tmp/platform-tools.zip -d "$ANDROID_HOME" \
  && rm /tmp/platform-tools.zip

RUN mkdir -p "$ANDROID_HOME/platforms" "$ANDROID_HOME/build-tools" "$ANDROID_HOME/licenses" \
  && curl -fL --retry 5 --retry-all-errors --retry-delay 5 --connect-timeout 20 --max-time 600 \
    "${ANDROID_REPOSITORY_URL}/platform-36_r01.zip" -o /tmp/platform-36.zip \
  && unzip -q /tmp/platform-36.zip -d /tmp/platform-36 \
  && mv /tmp/platform-36/* "$ANDROID_HOME/platforms/android-36" \
  && rm -rf /tmp/platform-36 /tmp/platform-36.zip \
  && curl -fL --retry 5 --retry-all-errors --retry-delay 5 --connect-timeout 20 --max-time 600 \
    "${ANDROID_REPOSITORY_URL}/build-tools_r36_linux.zip" -o /tmp/build-tools-36.zip \
  && unzip -q /tmp/build-tools-36.zip -d /tmp/build-tools-36 \
  && mv /tmp/build-tools-36/* "$ANDROID_HOME/build-tools/36.0.0" \
  && rm -rf /tmp/build-tools-36 /tmp/build-tools-36.zip \
  && printf '%s\n' \
    '8933bad161af4178b1185d1a37fbf41ea5269c55' \
    'd56f5187479451eabf01fb78af6dfcb131a6481e' \
    '24333f8a63b6825ea9c5514f83c2829b004d1fee' \
    > "$ANDROID_HOME/licenses/android-sdk-license"

WORKDIR /app

FROM android-base AS deps
COPY package*.json ./

ARG NPM_REGISTRY=https://registry.npmjs.org/
RUN --mount=type=cache,id=mydream-npm,target=/root/.npm,sharing=locked \
  npm ci --prefer-offline --registry="$NPM_REGISTRY"

FROM deps AS android-build
COPY . .

# Keep the billing SDK compatible with RN 0.85 on fresh npm ci installs.
# Fail before expensive native compilation if the upstream source has changed.
RUN node scripts/patch-poolakey-android.cjs

ARG ANDROID_GRADLE_VARIANT=Release
ARG ANDROID_ARCHITECTURES=arm64-v8a
ARG ANDROID_GRADLE_HEAP_MB=3072
ARG ANDROID_VERSION_CODE
ARG EXPO_PUBLIC_BUILD_SHA
ARG EXPO_PUBLIC_API_URL

ENV ANDROID_VERSION_CODE=${ANDROID_VERSION_CODE} \
  EXPO_PUBLIC_BUILD_SHA=${EXPO_PUBLIC_BUILD_SHA} \
  EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL}

RUN --mount=type=cache,id=mydream-expo,target=/root/.expo,sharing=locked \
  --mount=type=cache,id=mydream-gradle,target=/root/.gradle,sharing=locked \
  mkdir -p /out \
  && rm -f /root/.gradle/init.gradle \
  && npx expo prebuild --clean --platform android \
  && cd android \
  && chmod +x ./gradlew \
  && ANDROID_GRADLE_HEAP_MB="$ANDROID_GRADLE_HEAP_MB" \
    ANDROID_GRADLE_VARIANT="$ANDROID_GRADLE_VARIANT" \
    ANDROID_ARCHITECTURES="$ANDROID_ARCHITECTURES" \
    sh /app/scripts/build-android-gradle.sh \
  && apk_path="$(find /app/android/app/build/outputs/apk -type f -path "*/release/*.apk" -print -quit)" \
  && test -n "$apk_path" \
  && aab_path="$(find /app/android/app/build/outputs/bundle -type f -path "*/release/*.aab" -print -quit)" \
  && test -n "$aab_path" \
  && printf 'commit=%s\nversion_code=%s\n' "$EXPO_PUBLIC_BUILD_SHA" "$ANDROID_VERSION_CODE" > /out/build-metadata.txt \
  && cp "$apk_path" /out/app-release.apk \
  && cp "$aab_path" /out/app-release.aab

FROM scratch AS android-unsigned-artifacts
COPY --from=android-build /out/ /

# Fetch the official tool before any signing secrets are mounted. Pin both the
# release and GitHub's published asset digest; never execute an unchecked JAR.
FROM android-base AS bazaar-signer-tool
ARG BAZAAR_BUNDLE_SIGNER_VERSION=0.1.14
ARG BAZAAR_BUNDLE_SIGNER_SHA256=aef2c387f678558e3a4baddab9730fbdca64ef28a0e2e0245491e1088b4968f5
RUN mkdir -p /opt/cafebazaar \
  && curl -fL --retry 5 --retry-all-errors --retry-delay 5 --connect-timeout 20 --max-time 600 \
    "https://github.com/cafebazaar/bundle-signer/releases/download/v${BAZAAR_BUNDLE_SIGNER_VERSION}/bundlesigner-${BAZAAR_BUNDLE_SIGNER_VERSION}.jar" \
    -o /opt/cafebazaar/bundlesigner.jar \
  && printf '%s  %s\n' "$BAZAAR_BUNDLE_SIGNER_SHA256" /opt/cafebazaar/bundlesigner.jar | sha256sum -c - \
  && printf 'bundle_signer_version=%s\nbundle_signer_jar_sha256=%s\n' \
    "$BAZAAR_BUNDLE_SIGNER_VERSION" "$BAZAAR_BUNDLE_SIGNER_SHA256" \
    > /opt/cafebazaar/tool-metadata.txt

FROM android-build AS android-signed
RUN apt-get update && apt-get install -y --no-install-recommends zip \
  && rm -rf /var/lib/apt/lists/*
COPY --from=bazaar-signer-tool /opt/cafebazaar/ /opt/cafebazaar/
ARG ANDROID_KEY_ALIAS
ARG ANDROID_SIGNING_CERT_SHA256
RUN --network=none \
  --mount=type=secret,id=android_keystore,required=true \
  --mount=type=secret,id=android_store_password,required=true \
  --mount=type=secret,id=android_key_password,required=true \
  sh /app/scripts/sign-android.sh /out /signed-out

FROM scratch AS android-artifacts
COPY --from=android-signed /signed-out/ /
